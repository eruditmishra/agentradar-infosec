# Copy this file to .env and fill in the values before running the server.

# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Postgres connection string. Docker Compose sets this automatically for the
# containerized deployment — only needed for local (non-Docker) development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentradar

# Only set for a hosted multi-tenant deployment. Leave unset for a
# self-hosted single-tenant install.
# TENANT_ID=

# Set to false only if the app is NOT served over HTTPS (e.g. local dev, IP-based deployment)
SECURE_COOKIES=true

# ─── Auth secrets (required) ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Required — encrypts connector/integration secrets at rest.
# Generate with: openssl rand -hex 32
DISCOVERY_ENCRYPTION_KEY=

# ─── Initial admin seed (used by `npm run seed:admin`) ──────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=example_password

# ─── Microsoft SSO (optional — only needed to enable Microsoft Entra ID login) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Note: custom OIDC SSO (for non-super-admin roles) is configured per-deployment
# through the admin UI (/api/auth/sso/settings), not via environment variables.

# ─── Optional feature/security toggles ──────────────────────────────────────
# Restrict discovery results to AI-relevant resources only (default: true)
# DISCOVERY_AI_ONLY=true
# Enforce MFA for logins (default: true). Set to "false" only as an emergency
# escape hatch (e.g. a locked-out super_admin) — MFA is required by default
# for super_admin and for any other password-login user opted in via IAM.
# MFA_ENFORCEMENT_ENABLED=true
# Timeout in ms for outbound HTTP calls made by scanners/integrations (default: 25000)
# OUTBOUND_FETCH_TIMEOUT_MS=25000

# ─── Optional scanner tuning ─────────────────────────────────────────────────
# Each cloud scanner has its own set of *_MAX_* / *_SCAN limits with sensible
# defaults baked in (see server/src/modules/discovery/scanners/**). Uncomment
# and override only if you need to change discovery scope or performance, e.g.:
# AWS_DISCOVERY_MAX_RESOURCES=150
# AZURE_DISCOVERY_MAX_RESOURCES=150
# GCP_DISCOVERY_MAX_RESOURCES=150
# GIT_DISCOVERY_MAX_REPOS=100
